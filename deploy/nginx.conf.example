# Example nginx layout for Flash API.
# The panel is proxied to 127.0.0.1:3000. The static landing page is served
# from /opt/flash-home; its source is a separate project and is not part of
# this repository. Replace example.com with your own domain and adjust the
# certificate paths and the optional first-login gateway before use.

# example.com
# / 和 /home  -> 用户自定义静态首页（/opt/flash-home）
# 其余路径    -> new-api (127.0.0.1:3000)
# new-api 官方首页已在源码中删除；nginx 不再做任何页面重定向。

upstream newapi_backend {
    server 127.0.0.1:3000;
    keepalive 32;
}

# 首次登录自动设密网关（宿主小服务），失败回退 new-api 本体
upstream newapi_login {
    server 127.0.0.1:7865 max_fails=1 fail_timeout=10s;
    server 127.0.0.1:3000 backup;
    keepalive 8;
}

server {
    server_name example.com;

    access_log /var/log/nginx/example.com.access.log;
    error_log  /var/log/nginx/example.com.error.log;

    client_max_body_size 100m;

    # ---------- 用户自定义首页（静态 Vue 页面）----------
    location = / {
        root /opt/flash-home;
        try_files /index.html =404;
        default_type text/html;
        charset utf-8;
        add_header Cache-Control "no-store" always;
        add_header X-Landing "custom-home" always;
        sub_filter_once on;
        sub_filter '</body>' '<script src="/orbit-bridge.js" defer></script></body>';
    }

    location = /home {
        root /opt/flash-home;
        try_files /index.html =404;
        default_type text/html;
        charset utf-8;
        add_header Cache-Control "no-store" always;
        add_header X-Landing "custom-home" always;
        sub_filter_once on;
        sub_filter '</body>' '<script src="/orbit-bridge.js" defer></script></body>';
    }

    location = /index.html {
        root /opt/flash-home;
        try_files /index.html =404;
        default_type text/html;
        charset utf-8;
        add_header Cache-Control "no-store" always;
        add_header X-Landing "custom-home" always;
        sub_filter_once on;
        sub_filter '</body>' '<script src="/orbit-bridge.js" defer></script></body>';
    }

    location = /index.original.html {
        return 404;
    }

    location = /orbit-bridge.js {
        root /opt/flash-home;
        try_files /orbit-bridge.js =404;
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
    }

    location ^~ /assets/ {
        root /opt/flash-home;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        access_log off;
    }

    location ^~ /fonts/ {
        root /opt/flash-home;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
        access_log off;
    }

    location = /logo.svg {
        root /opt/flash-home;
        try_files /logo.svg =404;
        default_type image/svg+xml;
        expires 7d;
    }

    location = /api/v1/settings/public.json {
        alias /opt/flash-home/api/v1/settings/public.json;
        default_type application/json;
        charset utf-8;
        add_header Cache-Control "no-store" always;
    }

    location = /setup/status.json {
        alias /opt/flash-home/setup/status.json;
        default_type application/json;
        charset utf-8;
        add_header Cache-Control "no-store" always;
    }

    # ---------- 首次登录自动设密（精确匹配优先于下面所有块）----------
    location = /api/user/login {
        proxy_pass http://newapi_login;
        proxy_http_version 1.1;
        proxy_next_upstream error timeout http_502 http_504;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_read_timeout    120s;
    }

    # ---------- 其余全部交给 new-api ----------
    location / {
        include /etc/nginx/snippets/newapi-proxy.conf;
        proxy_pass http://newapi_backend;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/example.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = example.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name example.com;
    return 404; # managed by Certbot
}
